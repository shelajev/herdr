#!/bin/bash
# Verify the herdr-crew template tools are present. Used at image build time
# and as the kit's fast install-step check at sandbox creation. Exits non-zero
# with a clear message when the sandbox image is not the herdr-crew template.
set -u

export PATH="/home/agent/.local/bin:$PATH"

missing=""
for tool in herdr claude codex pi beans; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    missing="$missing $tool"
  fi
done

if [ -n "$missing" ]; then
  echo "herdr-crew: missing tools:$missing" >&2
  echo "herdr-crew: this sandbox is not running the herdr-crew template image." >&2
  echo "herdr-crew: build and load it with scripts/sbx/build-crew-template.sh," >&2
  echo "herdr-crew: then recreate the sandbox." >&2
  exit 1
fi

echo "herdr-crew: tools present:"
echo "  herdr  $(herdr --version 2>/dev/null | head -1)"
echo "  claude $(claude --version 2>/dev/null | head -1)"
echo "  codex  $(codex --version 2>/dev/null | head -1)"
echo "  pi     $(pi --version 2>/dev/null | head -1)"
echo "  beans  $(beans version 2>/dev/null | head -1)"
